# .env.example — Email delivery config for the briefing pipeline
# Copy this to .env and fill in your SMTP credentials.

# SMTP server (Gmail, Outlook, your own mail server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_or_regular_password

# From / To addresses
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com
